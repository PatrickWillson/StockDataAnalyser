# Stock Data Analyser - Environment Configuration
# Copy this file to .env and add your actual API key

# EODHD API Key (Required)
# Get your API key from: https://eodhd.com?via=patrick
#
# Required Package: Fundamentals Package
#   - Provides balance sheet, income statement, cash flow, and company fundamentals
#
# Optional Package: EOD Historical Data - All World Package
#   - Provides more accurate and complete dividend history across all exchanges
#   - Without this, the tool uses forward dividend rates as fallback
#
EODHD_API_KEY=your_api_key_here

# Fundamentals vendor (optional; default eodhd). Vendors are registered in clients/factory.py
# (see docs/CODEBASE_GUIDE.md section 12 for adding one).
FUNDAMENTALS_PROVIDER=eodhd

# Free path (FUNDAMENTALS_PROVIDER=free): US stocks from SEC EDGAR + Yahoo Finance, no API key.
# The SEC fair-access policy requires your name and a contact email in every request:
# SEC_USER_AGENT=Your Name you@example.com
# Optional, free path: European companies' history before their first ESEF report, from Eulerpool (vendor data,
# used only where it agrees with the filed reports; free plan is for non-commercial use). Never commit your key.
# EULERPOOL_API_KEY=your_eulerpool_key
